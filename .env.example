# VitaTwin — Environment variables (example only)
# Copy to .env.local and fill real values. Never commit .env.local.

# Supabase (optional — the demo twin works without these)
# Only the public URL and the anon public key are needed. The app never reads
# the service_role key, so do not add it here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: any future model keys (server-side only)
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Optional: public contact e-mail shown on the Privacy policy page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: server-only error alerts. Any Slack/Discord/JSON webhook URL.
# No NEXT_PUBLIC_ prefix, so it never reaches the browser.
# ERROR_WEBHOOK_URL=

# Optional: used only by `npm run backup` (scripts/backup-db.sh). Never commit.
# SUPABASE_DB_URL=

# Optional: shared rate limiting across serverless instances (free tier at upstash.com).
# Without these the app uses an in-memory limiter. Server-only; never NEXT_PUBLIC_.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
